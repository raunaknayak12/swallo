{
  "$defs": {
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "title": "Items",
          "type": "array"
        },
        "reason": {
          "enum": [
            "same_topic_different_value",
            "override_language",
            "heuristic_negation"
          ],
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "default": "unresolved",
          "enum": [
            "unresolved",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        }
      },
      "required": [
        "id",
        "items",
        "reason"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "Goal": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Goal",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "kind": {
          "enum": [
            "decision",
            "constraint",
            "question",
            "artifact_ref"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Item",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Redaction": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        },
        "types": {
          "items": {
            "type": "string"
          },
          "title": "Types",
          "type": "array"
        }
      },
      "title": "Redaction",
      "type": "object"
    },
    "RepoState": {
      "additionalProperties": false,
      "properties": {
        "git_commit": {
          "title": "Git Commit",
          "type": "string"
        },
        "dirty": {
          "default": false,
          "title": "Dirty",
          "type": "boolean"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Files",
          "type": "object"
        }
      },
      "required": [
        "git_commit"
      ],
      "title": "RepoState",
      "type": "object"
    },
    "Source": {
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "capture_method": {
          "enum": [
            "export",
            "paste",
            "connector",
            "ide-agent",
            "manual"
          ],
          "title": "Capture Method",
          "type": "string"
        },
        "captured_at": {
          "title": "Captured At",
          "type": "string"
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transcript"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "session_id",
        "agent",
        "capture_method",
        "captured_at"
      ],
      "title": "Source",
      "type": "object"
    },
    "Transcript": {
      "additionalProperties": false,
      "properties": {
        "object": {
          "description": "Content-addressed object hash, e.g. sha256:...",
          "title": "Object",
          "type": "string"
        },
        "redacted": {
          "default": true,
          "description": "Whether transcript is redacted",
          "title": "Redacted",
          "type": "boolean"
        }
      },
      "required": [
        "object"
      ],
      "title": "Transcript",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "project": {
      "title": "Project",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    },
    "merged_from": {
      "items": {
        "type": "string"
      },
      "title": "Merged From",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "goal": {
      "$ref": "#/$defs/Goal"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Item"
      },
      "title": "Items",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/Conflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "repo_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepoState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "redaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Redaction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "created_at",
    "project",
    "sources",
    "goal"
  ],
  "title": "Packet",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
